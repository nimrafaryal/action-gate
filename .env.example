# Copy to .env and fill in once AMD credits are approved.
# Any OpenAI-compatible endpoint works (AMD Token Factory / AMD Dev Cloud vLLM).
# Leave AMD_BASE_URL / AMD_MODEL empty to use the built-in mock planner.
AMD_BASE_URL=https://your-amd-endpoint/v1
AMD_API_KEY=your-api-key
AMD_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Gate policy settings (all optional — defaults shown).
ACTION_GATE_REFUND_LIMIT=500
ACTION_GATE_BULK_DELETE_THRESHOLD=3
ACTION_GATE_INTERNAL_DOMAIN=company.example
ACTION_GATE_EXPORT_DESTINATIONS=internal_review

# Dashboard -> API location.
ACTION_GATE_API_URL=http://127.0.0.1:8000
